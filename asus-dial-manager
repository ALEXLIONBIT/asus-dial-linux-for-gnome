def read_lang():
    try:
        with open(acfg.LANG_FILE) as f:
            lang = f.read().strip()
        return lang if lang in LI else "en"
    except OSError:
        return "en"


class EditDialog(Gtk.Dialog):
    """Create or edit a custom mode: name, icon and three key sequences, with a key recorder."""

    ACTIONS = (("click", "act_click"), ("cw", "act_cw"), ("ccw", "act_ccw"))

    def __init__(self, parent, tr, mode=None):
        super().__init__(title=tr("dlg_edit" if mode else "dlg_new"), transient_for=parent, modal=True)
        self.tr = tr
        self.recording = None  # (entry, button)
        self.set_default_size(560, -1)
        box = self.get_content_area()
        box.set_spacing(10)
        box.set_border_width(14)
        grid = Gtk.Grid(row_spacing=8, column_spacing=10)
        box.pack_start(grid, False, False, 0)

        grid.attach(Gtk.Label(label=tr("name"), xalign=0), 0, 0, 1, 1)
        self.name = Gtk.Entry(text=mode["name"] if mode else "", hexpand=True)
        grid.attach(self.name, 1, 0, 2, 1)
        grid.attach(Gtk.Label(label=tr("icon"), xalign=0), 0, 1, 1, 1)
        self.icon = Gtk.Entry(text=mode["icon"] if mode else "⌨", max_length=4, width_chars=5, halign=Gtk.Align.START)
        grid.attach(self.icon, 1, 1, 2, 1)

        hint = Gtk.Label(label=tr("keys_hint"), xalign=0, wrap=True)
        hint.get_style_context().add_class("dim-label")
        grid.attach(hint, 0, 2, 3, 1)
        self.entries, self.buttons = {}, {}
        for row, (key, label) in enumerate(self.ACTIONS, start=3):
            grid.attach(Gtk.Label(label=tr(label), xalign=0), 0, row, 1, 1)
            entry = Gtk.Entry(text=mode[key] if mode else "", hexpand=True)
            entry.connect("changed", lambda *_: self.validate())
            grid.attach(entry, 1, row, 1, 1)
            btn = Gtk.ToggleButton(label=tr("record"))
            btn.connect("toggled", self.on_record_toggled, key)
            grid.attach(btn, 2, row, 1, 1)
            self.entries[key], self.buttons[key] = entry, btn
        self.rec_hint = Gtk.Label(label="", xalign=0, wrap=True)
        grid.attach(self.rec_hint, 0, 6, 3, 1)
        self.error = Gtk.Label(label="", xalign=0, wrap=True)
        self.error.get_style_context().add_class("error")
        grid.attach(self.error, 0, 7, 3, 1)
        self.name.connect("changed", lambda *_: self.validate())

        self.add_button(tr("cancel"), Gtk.ResponseType.CANCEL)
        self.ok = self.add_button(tr("save"), Gtk.ResponseType.OK)
        self.ok.get_style_context().add_class("suggested-action")
        self.connect("key-press-event", self.on_key)
        self.show_all()
        self.validate()

    def validate(self):
        msg = ""
        if not self.name.get_text().strip():
            msg = self.tr("need_name")
        else:
            any_action = False
            for key, label in self.ACTIONS:
                text = self.entries[key].get_text()
                try:
                    any_action = bool(acfg.parse_sequence(text)) or any_action
                except ValueError as e:
                    msg = self.tr("bad_keys").format(field=self.tr(label), err=e)
                    break
            else:
                if not any_action:
                    msg = self.tr("need_action")
        self.error.set_text(msg)
        self.ok.set_sensitive(not msg)

    def on_record_toggled(self, btn, key):
        if btn.get_active():
            if self.recording and self.recording[1] is not btn:
                self.recording[1].set_active(False)
            self.recording = (self.entries[key], btn)
            btn.set_label(self.tr("stop"))
            self.rec_hint.set_text(self.tr("recording"))
            self.grab_focus()
        else:
            btn.set_label(self.tr("record"))
            if self.recording and self.recording[1] is btn:
                self.recording = None
                self.rec_hint.set_text("")

    def on_key(self, _w, event):
        if not self.recording:
            return False
        code = event.hardware_keycode - 8  # X11 keycode -> Linux key code
        if code in acfg.MOD_NAMES.values() or code not in acfg.CODE_NAMES:
            return True  # a modifier on its own or an unknown key: wait for the real key
        mods = [acfg.MOD_NAMES[name] for mask, name in MOD_MASKS if event.state & mask]
        entry = self.recording[0]
        text = (entry.get_text().strip() + " " + acfg.combo_text(mods, code)).strip()
        entry.set_text(text)
        return True

    def result(self, old=None):
        return {"id": old["id"] if old else None, "name": self.name.get_text().strip(),
                "icon": self.icon.get_text().strip() or "⌨",
                "click": self.entries["click"].get_text().strip(),
                "cw": self.entries["cw"].get_text().strip(), "ccw": self.entries["ccw"].get_text().strip()}


class Manager(Gtk.Window):
    def __init__(self):
        super().__init__()
        self.set_default_size(680, 560)
        self.set_wmclass("asus-dial-manager", "asus-dial-manager")
        self.lang = read_lang()
        self.cfg = acfg.load()
        self.root = None
        self.build()
        self.connect("destroy", Gtk.main_quit)

    def tr(self, key):
        return STR[key][LI[self.lang]]

    # ---------------------------------------------------------------- UI
    def build(self):
        if self.root:
            self.remove(self.root)
        self.set_title(self.tr("title"))
        nb = Gtk.Notebook()
        nb.append_page(self.build_modes_tab(), Gtk.Label(label=self.tr("tab_modes")))
        nb.append_page(self.build_general_tab(), Gtk.Label(label=self.tr("tab_general")))
        self.root = nb
        self.add(nb)
        self.show_all()
        self.update_buttons()

    def build_modes_tab(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, border_width=12)
        hint = Gtk.Label(label=self.tr("modes_hint"), xalign=0, wrap=True)
        hint.get_style_context().add_class("dim-label")
        page.pack_start(hint, False, False, 0)
        body = Gtk.Box(spacing=10)
        page.pack_start(body, True, True, 0)

        self.store = Gtk.ListStore(bool, str, str, str, str)  # on, icon, name, type, id
        self.view = Gtk.TreeView(model=self.store)
        toggle = Gtk.CellRendererToggle()
        toggle.connect("toggled", self.on_toggled)
        self.view.append_column(Gtk.TreeViewColumn(self.tr("col_on"), toggle, active=0))
        self.view.append_column(Gtk.TreeViewColumn("", Gtk.CellRendererText(), text=1))
        self.view.append_column(Gtk.TreeViewColumn(self.tr("col_mode"), Gtk.CellRendererText(), text=2))
        self.view.append_column(Gtk.TreeViewColumn(self.tr("col_type"), Gtk.CellRendererText(), text=3))
        self.view.get_selection().connect("changed", lambda *_: self.update_buttons())
        self.view.connect("row-activated", lambda *_: self.on_edit())
        scroll = Gtk.ScrolledWindow(hexpand=True, vexpand=True)
        scroll.add(self.view)
        body.pack_start(scroll, True, True, 0)

        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        body.pack_start(side, False, False, 0)
        self.btn = {}
        for key, handler in (("up", lambda *_: self.move(-1)), ("down", lambda *_: self.move(1)),
                             ("add", lambda *_: self.on_add()), ("edit", lambda *_: self.on_edit()),
                             ("delete", lambda *_: self.on_delete()), ("restore", lambda *_: self.on_restore())):
            b = Gtk.Button(label=self.tr(key))
            b.connect("clicked", handler)
            side.pack_start(b, False, False, 0)
            self.btn[key] = b
        self.refresh()
        return page

    def build_general_tab(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, border_width=16)
        page.pack_start(Gtk.Label(label=self.tr("language"), xalign=0), False, False, 0)
        combo = Gtk.ComboBoxText(halign=Gtk.Align.START)
        for code in acfg.LANGS:
            combo.append(code, acfg.LANG_NAMES[code])
        combo.set_active_id(self.lang)
        combo.connect("changed", self.on_lang)
        page.pack_start(combo, False, False, 0)

        sw = Gtk.CheckButton(label=self.tr("welcome"))
        sw.set_active(bool(self.cfg["welcome"].get("enabled", True)))
        sw.connect("toggled", self.on_welcome)
        page.pack_start(sw, False, False, 0)
        note = Gtk.Label(label=self.tr("welcome_note"), xalign=0, wrap=True)
        note.get_style_context().add_class("dim-label")
        page.pack_start(note, False, False, 0)

        path = Gtk.Label(label=self.tr("cfg_file").format(path=acfg.CONFIG_FILE), xalign=0, selectable=True, wrap=True)
        path.get_style_context().add_class("dim-label")
        page.pack_end(path, False, False, 0)
        return page

    # ---------------------------------------------------------------- data <-> list
    def mode_info(self, mode_id):
        """(icon, name, type text) of a mode id."""
        if mode_id.startswith("custom:"):
            c = next(c for c in self.cfg["custom"] if c["id"] == mode_id[7:])
            return c["icon"], c["name"], self.tr("custom")
        n = acfg.BUILTIN_IDS.index(mode_id)
        kind = "builtin_browser" if mode_id in acfg.BROWSER_ONLY_IDS else "builtin"
        return acfg.ICONS[n], acfg.NAMES_L[self.lang][n], self.tr(kind)

    def refresh(self, select_id=None):
        self.store.clear()
        for mode_id, enabled in acfg.all_modes(self.cfg):
            icon, name, kind = self.mode_info(mode_id)
            self.store.append([enabled, icon, name, kind, mode_id])
        if select_id:
            for row in self.store:
                if row[4] == select_id:
                    self.view.get_selection().select_iter(row.iter)
                    self.view.scroll_to_cell(row.path)
        self.update_buttons()

    def selected(self):
        model, it = self.view.get_selection().get_selected()
        return (model[it][4], model.get_path(it).get_indices()[0]) if it else (None, None)

    def update_buttons(self):
        if not hasattr(self, "btn"):
            return
        mode_id, pos = self.selected()
        custom = bool(mode_id and mode_id.startswith("custom:"))
        n = len(self.store)
        self.btn["up"].set_sensitive(pos is not None and pos > 0)
        self.btn["down"].set_sensitive(pos is not None and pos < n - 1)
        self.btn["edit"].set_sensitive(custom)
        self.btn["delete"].set_sensitive(custom)

    def save(self):
        acfg.save(self.cfg)

    def full_order(self):
        return [m for m, _ in acfg.all_modes(self.cfg)]

    # ---------------------------------------------------------------- actions
    def on_toggled(self, _cell, path):
        row = self.store[path]
        disabled = set(self.cfg["modes"].get("disabled", []))
        if row[0]:
            if len(self.store) - len(disabled) <= 1:
                self.message(self.tr("need_one"))
                return
            disabled.add(row[4])
        else:
            disabled.discard(row[4])
        self.cfg["modes"]["disabled"] = sorted(disabled)
        self.save()
        row[0] = not row[0]

    def move(self, delta):
        mode_id, pos = self.selected()
        order = self.full_order()
        j = pos + delta
        if mode_id is None or not 0 <= j < len(order):
            return
        order[pos], order[j] = order[j], order[pos]
        self.cfg["modes"]["order"] = order
        self.save()
        self.refresh(mode_id)

    def edit_dialog(self, mode=None):
        dlg = EditDialog(self, self.tr, mode)
        resp = dlg.run()
        res = dlg.result(mode) if resp == Gtk.ResponseType.OK else None
        dlg.destroy()
        return res

    def on_add(self):
        res = self.edit_dialog()
        if not res:
            return
        res["id"] = acfg.slug(res["name"], {c["id"] for c in self.cfg["custom"]})
        self.cfg["custom"].append(res)
        self.cfg["modes"]["order"] = self.full_order()
        self.save()
        self.refresh("custom:" + res["id"])

    def on_edit(self):
        mode_id, _ = self.selected()
        if not mode_id or not mode_id.startswith("custom:"):
            return
        old = next(c for c in self.cfg["custom"] if c["id"] == mode_id[7:])
        res = self.edit_dialog(old)
        if res:
            old.update({k: res[k] for k in ("name", "icon", "click", "cw", "ccw")})
            self.save()
            self.refresh(mode_id)

    def on_delete(self):
        mode_id, _ = self.selected()
        if not mode_id or not mode_id.startswith("custom:"):
            return
        name = self.mode_info(mode_id)[1]
        if not self.confirm(self.tr("confirm_delete").format(name=name)):
            return
        self.cfg["custom"] = [c for c in self.cfg["custom"] if c["id"] != mode_id[7:]]
        for key in ("order", "disabled"):
            self.cfg["modes"][key] = [m for m in self.cfg["modes"].get(key, []) if m != mode_id]
        self.save()
        self.refresh()

    def on_restore(self):
        if not self.confirm(self.tr("confirm_restore")):
            return
        self.cfg["modes"]["disabled"] = []
        self.cfg["modes"]["order"] = list(acfg.DEFAULT_ORDER) + ["custom:" + c["id"] for c in self.cfg["custom"]]
        self.save()
        self.refresh()

    def on_lang(self, combo):
        lang = combo.get_active_id()
        if lang and lang != self.lang:
            self.lang = lang
            try:
                os.makedirs(os.path.dirname(acfg.LANG_FILE), exist_ok=True)
                with open(acfg.LANG_FILE, "w") as f:
                    f.write(lang)
            except OSError:
                pass
            GLib.idle_add(self.build)  # rebuild after the combo has finished handling the click

    def on_welcome(self, btn):
        self.cfg["welcome"]["enabled"] = btn.get_active()
        self.save()

    # ---------------------------------------------------------------- small dialogs
    def message(self, text):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.INFO,
                              buttons=Gtk.ButtonsType.OK, text=text)
        d.run()
        d.destroy()

    def confirm(self, text):
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                              buttons=Gtk.ButtonsType.OK_CANCEL, text=text)
        ok = d.run() == Gtk.ResponseType.OK
        d.destroy()
        return ok


def main():
    GLib.set_prgname("asus-dial-manager")
    win = Manager()
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
